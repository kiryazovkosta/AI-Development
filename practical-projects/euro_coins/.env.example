# Settings for `npm run coins:sync` (scripts/sync-coin-images.mjs).
# Copy this file to .env in the same folder and fill in the values from
# Supabase: Project Settings -> API Keys. .env is git-ignored; never commit it.
#
# Use a secret key (sb_secret_...). It bypasses row level security, so use it
# only on your own computer, never in the app or in Vercel.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_<...>
