# Settings for `npm run coins:sync` (scripts/sync-coin-images.mjs).
# Copy this file to .env in the same folder and fill in the values from
# Supabase: Project Settings -> API. .env is git-ignored; never commit it.
#
# The service role key bypasses row level security. Use it only on your own
# computer, never in the app or in Vercel.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
